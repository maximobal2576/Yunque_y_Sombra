[node name="EtiquetaTextoCarta" type="Label" parent="ContenedorPergamino/PanelPergamino/ContenedorVertical"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/font_color = Color(0.129412, 0.101961, 0.086275, 1)
theme_override_constants/line_spacing = 6
theme_override_font_sizes/font_size = 14
text = "Hijo mío:

Perdóname por enviarte a este rincón olvidado... Tu tío era el herrero más sabio del pueblo, pero hace tiempo que nadie sabe de él.

He vendido lo poco que nos quedaba para que aprendas su oficio y encuentres tu propio camino.

El pueblo es humilde y las calles están en sombras, pero en su taller encontrarás el yunque y el fuego.

Cuídate de los guardias del feudo y no hagas preguntas indiscretas.

Con amor, Tu Madre."
autowrap_mode = 2

